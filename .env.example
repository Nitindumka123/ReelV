# ==============================================================================
# ReelVault Production Environment Configuration
# ==============================================================================

# Core Application URL & Environment
APP_URL="https://reelvault.app"
NODE_ENV="production"
PORT=3000

# CORS Origins (Comma-separated list of allowed production domains)
ALLOWED_ORIGINS="https://reelvault.app,https://www.reelvault.app"

# Extractor Service Architecture (FastAPI + yt-dlp)
# Point this to your local or containerized microservice instance
EXTRACTOR_URL=http://127.0.0.1:8000
EXTRACTOR_HEALTH_URL=http://127.0.0.1:8000/health
EXTRACTOR_TIMEOUT_MS=120000
EXTRACTOR_MAX_CONCURRENCY=2

# Rate Limiting & Abuse Prevention
# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum resolve requests allowed per IP within the window
RATE_LIMIT_MAX_REQUESTS=10
# Maximum streaming download requests allowed per IP within the window
DOWNLOAD_RATE_LIMIT_MAX=10

# Concurrency Controls (Express server-level)
MAX_CONCURRENT_RESOLVE=3
MAX_CONCURRENT_DOWNLOAD=2

# Media Streaming & Resource Constraints
# Maximum allowed download size in bytes (default: 524288000 = 500MB)
MAX_MEDIA_SIZE_BYTES=524288000

# Secure Download Token Configuration
# Token TTL in milliseconds (default: 3600000 = 1 hour)
TOKEN_TTL_MS=3600000
# Maximum in-memory tokens before eviction
MAX_ACTIVE_TOKENS=10000

